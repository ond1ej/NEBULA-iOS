          }
        }
      }
    },
    "NEBULA did not confirm that the agent was created (%@). Check the agent list; retrying is safe, at most one agent is created." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEBULA nepotvrdila vytvoření agenta (%@). Zkontrolujte seznam agentů; opakování je bezpečné – vznikne nejvýš jeden agent."
          }
        }
      }
    },
    "NEBULA fills in the details in the isolated browser. The agent never sees the password." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEBULA vyplní údaje v izolovaném prohlížeči. Agent heslo nikdy neuvidí."
          }
        }
      }
    },
    "NEBULA has not confirmed the result yet. The VM may still be changing state. The status updates by itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEBULA zatím nepotvrdila výsledek – VM se možná ještě přepíná. Stav se aktualizuje sám."
          }
        }
      }
    },
    "NEBULA has not confirmed the result yet. The action may still be running. The status updates by itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEBULA zatím nepotvrdila výsledek – akce možná ještě probíhá. Stav se aktualizuje sám."
