    "NSCameraUsageDescription" : {
      "comment" : "Info.plist: NSCameraUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera slouží jen k naskenování párovacího QR kódu z vašeho Macu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used only to scan the pairing QR code from your Mac."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Info.plist: NSFaceIDUsageDescription",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEBULA používá Face ID k potvrzení, že jste to vy, a k odemknutí trezoru."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEBULA uses Face ID to confirm it is you and to unlock the vault."
          }
        }
      }
    },
