// NEBULA Apple apps: signing and identifiers. Committed defaults, safe for everybody.
//
// With these defaults you can build and run on the iOS Simulator and on your own Mac without an Apple developer
// account: simulator builds are signed ad hoc and the Mac app is signed "to run locally".
//
// To run on a real iPhone, or to give the Mac app a provisioned keychain, put your values in Config/Local.xcconfig
// (git-ignored; start from Local.xcconfig.example). Do not edit this file for that.

// Reverse-DNS prefix of the bundle identifiers: <prefix>.nebula (iOS), <prefix>.nebula.mac (macOS).
// It also names the Keychain service and the log subsystem, and it is the pairing URL type name.
NEBULA_BUNDLE_ID_PREFIX = com.example

// Your Apple Developer Team ID (10 characters). Empty = no team.
DEVELOPMENT_TEAM =

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY[sdk=macosx*] = -

// Mac entitlements. The default has the app sandbox only. NEBULA-provisioned.entitlements adds a keychain access
// group, which needs a team (see Local.xcconfig.example).
NEBULA_MAC_ENTITLEMENTS = macOS/NEBULA.entitlements

// iOS entitlements. Empty = none. Remote push needs iOS/NEBULA-push.entitlements, a team and your own APNs key.
NEBULA_IOS_ENTITLEMENTS =

#include? "Local.xcconfig"
